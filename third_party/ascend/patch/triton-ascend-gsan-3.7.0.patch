+  # missing) so the NVIDIA plugin still builds without it.
   find_program(TRITON_GSAN_CLANGXX NAMES clang++
                PATHS "${LLVM_SYSPATH}/bin"
-               REQUIRED NO_DEFAULT_PATH)
+               NO_DEFAULT_PATH)
   if(NOT TRITON_GSAN_CLANGXX)
-    message(FATAL_ERROR "clang++ is required to build gsan.ll")
+    set(TRITON_GSAN_DISABLE ON)
+    message(STATUS "clang++ not found in ${LLVM_SYSPATH}/bin; disabling GSan runtime build")
   endif()
 
